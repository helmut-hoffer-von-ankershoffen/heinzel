# The README demo, generated by scripts/demo_tape.py from docs/assets/demo-intro.tape and the demo.tape
# snippets of the modules; edit those and run `make fix`. Render it with `make demo`.

Output docs/assets/demo.gif

Require hz

Set Shell bash
Set Theme "Catppuccin Mocha"
Set FontSize 16
Set Width 1200
Set Height 720
Set Padding 20
Set Framerate 12
Set TypingSpeed 35ms
Set PlaybackSpeed 1.0
Set WaitPattern /\$\s*$/

Hide
# A quiet prompt; installation has already completed in the isolated recording environment.
Type `export PS1='$ '`
Enter
Type "clear"
Enter
Show

Type "hz --version"
Enter
Wait
Sleep 1.5s

Hide
Type "clear"
Enter
Show
Type "hz system info"
Enter
Wait
Sleep 3s

# --- src/heinzel/modules/system/doctor ---
Hide
Type "clear"
Enter
Show
Type "hz system doctor"
Enter
Wait
Sleep 3s

Sleep 2s
