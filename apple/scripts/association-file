#!/usr/bin/env python3
"""Print the Associated Domains file for the signed Heinzel app."""

import argparse
import json
import re
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("app_identifier_prefix")
args = parser.parse_args()
if not re.fullmatch(r"[A-Z0-9]{10}", args.app_identifier_prefix):
    parser.error("Provide the ten-character Application Identifier Prefix from the signing profile.")
template = Path(__file__).resolve().parents[1] / "distribution" / "apple-app-site-association"
association = json.loads(template.read_text().replace("@APP_IDENTIFIER_PREFIX@", args.app_identifier_prefix))
print(json.dumps(association, indent=2))  # noqa: T201 - the association file is the command output
