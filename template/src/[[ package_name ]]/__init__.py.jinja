"""[[ plugin_summary ]]

A Heinzelmännchen plugin, discovered through the `heinzel.modules` entry point in pyproject.toml. Every package
below it that declares `module = Module(...)` becomes a submodule (see `hello/`).
"""

from pathlib import Path

from heinzel import ConfigEditor, MetricWidget, Module, Navigate, NoticeKind, Notifications, Prompter, StatusItem

from [[ package_name ]]._models import [[ class_prefix ]]About, [[ class_prefix ]]Settings
from [[ package_name ]]._service import [[ class_prefix ]]Service

module = Module("[[ plugin_name ]]", "[[ plugin_summary ]]")
module.settings([[ class_prefix ]]Settings)
module.service([[ class_prefix ]]Service)


@module.operation
def info(service: [[ class_prefix ]]Service) -> [[ class_prefix ]]About:
    """Show this plugin's version, the Heinzelmännchen it runs on and the modules it brings."""
    return service.about()


@module.info
def system_info(service: [[ class_prefix ]]Service) -> [[ class_prefix ]]About:
    """Contribute this plugin's details to `hz system info`."""
    return service.about()


@module.setup(required=False)  # optional: `hz setup` offers to skip it; `hz setup [[ plugin_name ]]` runs it alone
def setup(settings: [[ class_prefix ]]Settings, prompter: Prompter, editor: ConfigEditor) -> None:
    """Choose how `hello` greets."""
    greeting = prompter.text("How should `hello` greet?", default=settings.greeting)
    path = editor.write("[[ plugin_name ]].greeting", greeting)  # validated like `hz system config set`, user scope
    prompter.say(f"Saved to {path}.")


__all__ = ["[[ class_prefix ]]About", "[[ class_prefix ]]Service", "[[ class_prefix ]]Settings", "module"]


@module.status(source="info", order=500, slots={"footer": True, "sidebar": True})
def status(about: [[ class_prefix ]]About) -> StatusItem:
    """Show this plugin's version in the footer and sidebar."""
    return StatusItem(text=f"[[ plugin_name ]] {about.version}", icon="star")


@module.widget(source="info", order=500)
def today(about: [[ class_prefix ]]About) -> MetricWidget:
    """Contribute a compact version widget to Today."""
    return MetricWidget(label="[[ plugin_name ]]", value=about.version)


@module.operation(read_only=False)
def notify(notifications: Notifications) -> str:
    """Send a sample notice through the user's notification policy."""
    notice = notifications.emit(
        NoticeKind.PLUGIN, "[[ plugin_name ]] is ready", route="/", command="hz [[ plugin_name ]] info", key="[[ plugin_name ]]:ready"
    )
    return notice.title if notice else "Notifications are off"


module.action("inspect", label="[[ plugin_name ]]", icon="star", effect=Navigate(path="/?panel=[[ plugin_name ]]:inspector"), order=500)
module.nav(title="[[ plugin_name ]]", icon="star", sidebar=Navigate(path="/?panel=[[ plugin_name ]]:inspector"), order=500)
module.view(
    Path(__file__).parent / "views",
    abi=1,
    name="inspector",
    source="info",
    title="[[ plugin_name ]]",
    fallback="Run hz [[ plugin_name ]] info.",
)
